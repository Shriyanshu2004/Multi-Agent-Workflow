# ─── Google Gemini (free tier — no credit card required) ─────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...your-gemini-api-key-here...
LLM_MODEL_NAME=gemini/gemini-1.5-flash   # or gemini/gemini-1.5-pro for higher quality

# ─── OpenAI (optional — only needed if switching back to GPT models) ──────────
# OPENAI_API_KEY=sk-...your-openai-api-key-here...
# OPENAI_MODEL_NAME=gpt-4o-mini

# ─── Serper (Google Search) ───────────────────────────────────────────────────
SERPER_API_KEY=...your-serper-api-key-here...   # https://serper.dev

# ─── Backend Configuration ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
BACKEND_PORT=8000
