# ─── Groq (free tier — no credit card required) ──────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...your-groq-api-key-here...
LLM_MODEL_NAME=groq/llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024

# ─── Disable litellm prompt caching (not supported by Groq) ──────────────────
LITELLM_DROP_PARAMS=True

# ─── Serper (Google Search) ───────────────────────────────────────────────────
SERPER_API_KEY=...your-serper-api-key-here...   # https://serper.dev

# ─── Backend Configuration ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
BACKEND_PORT=8000
